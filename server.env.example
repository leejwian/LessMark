# 새 서버의 LessMark/에서 server.env로 복사한다. ./lessmark가 읽는 Bash 설정이다.
LERRA_PYTHON="$PWD/.venv/bin/python"

# 원본 서버의 /data에 해당하는 폴더. rsync 목적지도 같은 값으로 지정한다.
# 실제 입력은 $LERRA_DATA_ROOT/lerra_parameter_watermark_protocol/ 아래에 있다.
LERRA_DATA_ROOT=/scratch/lerra-inputs

# 새 서버가 학습 상태·가중치·평가 결과를 기록할 폴더. 재개 시 같은 값을 쓴다.
LERRA_OUTPUT=/scratch/lerra-runs/experiment_2_strength_selection

# parallel은 기본적으로 할당된 물리 GPU를 탐색한다. 특정 카드만 쓰려면
# nvidia-smi의 번호 또는 전체 UUID를 쉼표로 연결한다. 메모리 기준 단위는 MiB다.
# LERRA_GPU_IDS=0,1
# LERRA_MIN_FREE_MIB=20480

# 오류는 기본적으로 로컬에 기록한다. Gmail 전송을 사용할 때 지정한다.
# LERRA_NOTIFICATION_MODE=smtp
# LERRA_MAIL_ACCOUNT=your-account@gmail.com
# LERRA_MAIL_PASSWORD_FILE="$HOME/.config/lessmark/gmail-app-password"
